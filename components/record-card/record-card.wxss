/* 记录卡片 — 从 list.wxss 抽离 */
.record-card{display:flex;padding:18rpx;margin-bottom:16rpx;background:var(--card-bg);border:1rpx solid var(--border);border-radius:var(--radius);box-shadow:0 10rpx 26rpx var(--shadow-sm)}
.card-img{width:164rpx;height:164rpx;border-radius:8rpx;margin-right:20rpx;flex-shrink:0;background:#ead9c3}
.card-img--no{display:flex;align-items:center;justify-content:center;color:#8f321d;font-size:48rpx;font-weight:900;background:linear-gradient(135deg,#f2d7b8,var(--accent-bg))}
.card-info{flex:1;display:flex;flex-direction:column;justify-content:center;min-width:0}
.card-name{font-size:32rpx;font-weight:800;margin-bottom:8rpx;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.card-address{font-size:24rpx;color:var(--text-secondary);line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
