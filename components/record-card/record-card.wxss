/* 记录卡片 — 从 list.wxss 抽离 */
.record-card{display:flex;padding:20rpx;margin-bottom:18rpx;background:#fffaf3;border:1rpx solid rgba(128,73,39,.14);border-radius:18rpx;box-shadow:0 12rpx 30rpx rgba(93,50,24,.08)}
.card-img{width:168rpx;height:168rpx;border-radius:14rpx;margin-right:22rpx;flex-shrink:0;background:#ead9c3}
.card-img--no{display:flex;align-items:center;justify-content:center;color:#8f321d;font-size:48rpx;font-weight:900;background:linear-gradient(135deg,#f5dfc1,#f9c88f)}
.card-info{flex:1;display:flex;flex-direction:column;justify-content:center;min-width:0}
.card-head{display:flex;align-items:center;margin-bottom:8rpx;min-width:0}
.card-name{flex:1;min-width:0;font-size:32rpx;font-weight:800;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.visit-pill{flex-shrink:0;margin-left:12rpx;padding:4rpx 12rpx;border-radius:999rpx;background:#f4eadc;color:#8a6041;font-size:20rpx;font-weight:700;line-height:1.4}
.visit-pill--hot{background:#8f321d;color:#fff7ed}
.review-title{margin-bottom:8rpx;color:#5e3a24;font-size:26rpx;font-weight:700;line-height:1.35;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.card-meta{display:flex;align-items:center;margin-bottom:8rpx;color:#a0622e;font-size:23rpx;font-weight:600;line-height:1.4;min-width:0}
.meta-text{max-width:260rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.meta-dot{margin:0 10rpx;color:#d2a46f}
.card-address{margin-top:6rpx;font-size:24rpx;color:var(--text-secondary);line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
