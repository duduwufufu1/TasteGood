page {
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  background-color: #f7f1e7;
  color: #251f1a;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
}

view, text, input, textarea, button {
  box-sizing: border-box;
}

.container { padding: 24rpx; }
.card {
  background: #fffaf2;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(67, 49, 33, 0.1);
  box-shadow: 0 10rpx 28rpx rgba(76, 54, 32, 0.08);
}
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
.page-title {
  font-size: 44rpx;
  font-weight: 800;
  padding: 36rpx 28rpx 18rpx;
  color: #251f1a;
  letter-spacing: 0;
}
