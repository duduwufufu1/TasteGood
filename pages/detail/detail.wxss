.page{min-height:100vh;background:#f7f1e7;padding-bottom:140rpx}
.photo-swiper{width:100%;height:460rpx;background:#f7f1e7;position:relative;overflow:hidden}
.photo-swiper swiper{width:100%;height:460rpx;display:block}
.photo-swiper swiper-item{width:100%;height:460rpx;display:block;background:#f7f1e7}
.swiper-img{width:100%;height:460rpx;display:block;background:#f7f1e7}
.no-photo{display:flex;align-items:center;justify-content:center;height:460rpx;color:#e6cfb6;font-size:30rpx;background:linear-gradient(135deg,#2f281f,#6b4a2d)}
.info-card{background:#fffaf2;padding:30rpx;margin:-46rpx 24rpx 20rpx;position:relative;z-index:2;border-radius:14rpx;border:1rpx solid rgba(75,54,34,0.1);box-shadow:0 16rpx 34rpx rgba(76,54,32,0.12)}
.shop-name{font-size:42rpx;font-weight:900;margin-bottom:12rpx;color:#251f1a;line-height:1.18}
.rating-line{margin-bottom:14rpx}.star-d{font-size:34rpx;color:#d4c0aa;margin-right:4rpx}.star-d.active{color:#d8512f}
.address{font-size:26rpx;color:#7b5e43;margin-bottom:16rpx;line-height:1.45}
.tags{display:flex;flex-wrap:wrap;gap:10rpx}.tag-d{padding:8rpx 16rpx;background:#f1dfc9;color:#8f321d;border-radius:12rpx;font-size:22rpx;font-weight:700}
.comment-card{background:#fffaf2;padding:30rpx;margin:0 24rpx 34rpx;border-radius:14rpx;border:1rpx solid rgba(75,54,34,0.1);position:relative;z-index:1}
.comment-title{font-size:28rpx;font-weight:900;color:#251f1a;margin-bottom:14rpx}
.comment-text{font-size:29rpx;line-height:1.75;color:#2f281f;word-break:break-all}.comment-time{font-size:23rpx;color:#a78a6d;margin-top:18rpx}
.action-bar{display:flex;gap:14rpx;padding:0 24rpx 34rpx;justify-content:center}
.act-btn{flex:1;padding:20rpx;border-radius:12rpx;border:1rpx solid #d8b58d;background:#fffaf2;color:#5c4532;font-size:28rpx;text-align:center}
.act-btn.del{color:#b33a28;border-color:#d98d80;background:#fff2ee}.act-btn.nav{background:#d8512f;color:#fff;border-color:#d8512f;box-shadow:0 12rpx 24rpx rgba(216,81,47,0.2)}
