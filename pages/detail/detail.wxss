.page{min-height:100vh;background:var(--bg);padding-bottom:140rpx}
.photo-swiper{width:100%;height:460rpx;background:var(--bg);position:relative;overflow:hidden}
.photo-swiper swiper{width:100%;height:460rpx;display:block}
.photo-swiper swiper-item{width:100%;height:460rpx;display:block;background:var(--bg)}
.swiper-img{width:100%;height:460rpx;display:block;background:var(--bg)}
.no-photo{display:flex;align-items:center;justify-content:center;height:460rpx;color:#e6cfb6;font-size:30rpx;background:linear-gradient(135deg,var(--text-dark),#6b4a2d)}
.info-card{background:var(--card-bg);padding:30rpx;margin:-46rpx 24rpx 20rpx;position:relative;z-index:2;border-radius:var(--radius-lg);border:1rpx solid var(--border);box-shadow:0 16rpx 34rpx var(--shadow-lg)}
.shop-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx;margin-bottom:12rpx}
.shop-name{flex:1;font-size:42rpx;font-weight:900;color:var(--text);line-height:1.18}
.visit-badge{flex-shrink:0;padding:8rpx 16rpx;border-radius:999rpx;background:linear-gradient(135deg,#fff3dc,#ffd7bf);border:1rpx solid #f0c4a4;color:#9a3a22;font-size:22rpx;font-weight:900;box-shadow:0 8rpx 18rpx rgba(154,58,34,.12)}
.review-title{margin-bottom:14rpx;padding:16rpx 18rpx;background:var(--accent-light);border-left:6rpx solid var(--primary);border-radius:var(--radius-sm);color:var(--primary-dark);font-size:29rpx;font-weight:900;line-height:1.45}
.record-meta{display:flex;flex-wrap:wrap;align-items:center;gap:10rpx;margin-bottom:16rpx;color:#76583f;font-size:25rpx;font-weight:700;line-height:1.4}
.meta-divider{color:#c49b73;font-weight:700}
.star-rating{margin-bottom:14rpx}
.address{font-size:26rpx;color:#7b5e43;margin-bottom:16rpx;line-height:1.45}
.visit-tip{display:inline-flex;margin-bottom:16rpx;padding:8rpx 14rpx;border-radius:999rpx;background:#fff7ea;color:#9b7350;font-size:22rpx;font-weight:700;border:1rpx solid #f1ddc6}
.tags{display:flex;flex-wrap:wrap;gap:10rpx}.tag-d{padding:8rpx 16rpx;background:var(--accent-light);color:#8f321d;border-radius:var(--radius);font-size:22rpx;font-weight:700}
.visit-section{margin:0 24rpx 34rpx}
.section-head{display:flex;align-items:center;justify-content:space-between;margin:10rpx 4rpx 18rpx}
.section-title{font-size:31rpx;font-weight:900;color:var(--text);line-height:1.25}
.section-count{padding:7rpx 14rpx;border-radius:999rpx;background:#4f3828;color:#fff4e8;font-size:20rpx;font-weight:900;letter-spacing:0}
.visit-swiper-wrap{position:relative;padding:24rpx 16rpx 26rpx;border-radius:var(--radius-lg);background:linear-gradient(135deg,#fff3e3,#ffe8d1 52%,#fff8ed);border:1rpx solid #f0d2b6;box-shadow:inset 0 1rpx 0 rgba(255,255,255,.76)}
.stack-shadow{position:absolute;left:42rpx;right:42rpx;height:112rpx;border-radius:28rpx;background:rgba(255,250,242,.78);border:1rpx solid rgba(224,178,139,.45);box-shadow:0 14rpx 24rpx rgba(98,61,32,.08)}
.stack-shadow-a{top:38rpx;transform:rotate(-1.8deg)}
.stack-shadow-b{top:54rpx;transform:rotate(1.5deg)}
.visit-swiper{height:520rpx;position:relative;z-index:1}
.visit-swiper swiper-item{height:520rpx}
.visit-card{min-height:430rpx;margin:0 8rpx;padding:30rpx;border-radius:28rpx;background:linear-gradient(180deg,#fffdf8,#fff7ed);border:1rpx solid rgba(220,180,142,.72);box-shadow:0 18rpx 32rpx rgba(89,56,32,.16)}
.visit-card-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:20rpx}
.visit-label{padding:8rpx 18rpx;border-radius:999rpx;background:#ffe3ca;color:#9c3a22;font-size:23rpx;font-weight:900}
.visit-time{font-size:22rpx;color:#ad8b6b;font-weight:700}
.visit-title{margin-bottom:16rpx;color:#39291d;font-size:34rpx;font-weight:900;line-height:1.32}
.visit-meta{display:flex;flex-wrap:wrap;gap:10rpx;margin-bottom:18rpx}
.meta-pill{padding:9rpx 16rpx;border-radius:999rpx;background:#fff0df;color:#7a5234;font-size:23rpx;font-weight:800;border:1rpx solid #efd1b7}
.visit-tags{display:flex;flex-wrap:wrap;gap:10rpx;margin:6rpx 0 18rpx}
.visit-tag{padding:7rpx 14rpx;border-radius:999rpx;background:#fff6eb;color:#8f321d;font-size:21rpx;font-weight:800;border:1rpx solid #f0dcc5}
.visit-comment{margin-top:16rpx;padding-top:18rpx;border-top:1rpx solid #f1deca;color:#503827;font-size:29rpx;line-height:1.7;word-break:break-all}
.visit-empty{margin-top:26rpx;padding:28rpx;border-radius:20rpx;background:#fff6ea;color:#a98767;font-size:26rpx;text-align:center}
.action-bar{display:flex;gap:14rpx;padding:0 24rpx 34rpx;justify-content:center}
.act-btn{flex:1;padding:20rpx;border-radius:var(--radius);border:1rpx solid var(--border-warm);background:var(--card-bg);color:#5c4532;font-size:28rpx;text-align:center}
.act-btn.del{color:var(--primary-dark);border-color:#d98d80;background:#fff2ee}.act-btn.nav{background:var(--primary);color:#fff;border-color:var(--primary);box-shadow:0 12rpx 24rpx var(--primary-shadow)}
