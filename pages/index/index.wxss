/* === index 地图页主题（深色渐变） === */
.page{height:100vh;display:flex;flex-direction:column;position:relative;overflow:hidden;background:linear-gradient(180deg,#2d271f 0,#5a3c25 180rpx,#ead9c3 181rpx,#ead9c3 100%)}
.map-card{position:relative;z-index:1;flex:1;margin:24rpx 18rpx 22rpx;border-radius:var(--radius);overflow:hidden;border:8rpx solid #fff8ec;box-shadow:0 24rpx 50rpx rgba(76,54,32,0.16)}
.full-map{width:100%;height:100%}
.map-reset{position:absolute;right:20rpx;top:20rpx;z-index:9;width:58rpx;height:58rpx;line-height:58rpx;text-align:center;border-radius:50%;background:rgba(37,31,26,0.86);color:var(--card-bg);font-size:32rpx;font-weight:900;box-shadow:0 10rpx 20rpx rgba(37,31,26,0.18)}
.map-note{position:absolute;left:42rpx;right:42rpx;bottom:42rpx;z-index:8;padding:18rpx 18rpx 18rpx 22rpx;background:rgba(37,31,26,0.82);color:#fff;border-radius:var(--radius-lg);border:1rpx solid rgba(255,255,255,0.16);display:flex;align-items:center;gap:18rpx}
.note-text{flex:1;min-width:0}
.note-title{display:block;font-size:30rpx;font-weight:800;margin-bottom:6rpx}
.note-copy{display:block;font-size:23rpx;color:#f3dfc5;line-height:1.45}
.note-add{width:68rpx;height:68rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--primary);color:#fff;font-size:42rpx;font-weight:800;box-shadow:0 12rpx 24rpx var(--primary-shadow);flex-shrink:0}
.overlay{position:fixed;inset:0;background:rgba(37,31,26,0.5);z-index:100;display:none}.overlay.show{display:block}
.panel{position:absolute;bottom:0;left:0;right:0;background:var(--card-bg);border-radius:24rpx 24rpx 0 0;max-height:72vh;display:flex;flex-direction:column;border-top:1rpx solid rgba(67,49,33,0.12)}
.panel-hd{display:flex;justify-content:space-between;align-items:center;padding:30rpx 28rpx;border-bottom:1rpx solid #ecdcc9}
.panel-title{font-size:32rpx;font-weight:800;color:var(--text)}.panel-close{font-size:26rpx;color:var(--text-secondary);padding:10rpx 14rpx;background:var(--accent-light);border-radius:var(--radius)}
.panel-list{padding:0 28rpx;overflow-y:auto}.panel-item{display:flex;justify-content:space-between;align-items:center;padding:28rpx 0;border-bottom:1rpx solid #efe0cf;font-size:30rpx}
.pi-name{font-weight:700;color:#2b241d}.pi-count{font-size:25rpx;color:var(--text-muted)}
