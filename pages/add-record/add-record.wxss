.page{min-height:100vh;background:var(--bg);padding-bottom:48rpx}
.form-hero{padding:38rpx 28rpx 24rpx;background:var(--text-dark);color:#fff}
.eyebrow{display:block;font-size:20rpx;color:#eab071;font-weight:800;letter-spacing:0;margin-bottom:8rpx}
.hero-title{font-size:46rpx;font-weight:900}
.login-guide{position:relative;margin:26rpx 24rpx 0;padding:34rpx 30rpx 30rpx;background:linear-gradient(135deg,#fffaf0 0%,#fff0dc 56%,#edf5ee 100%);border:1rpx solid rgba(216,81,47,0.14);border-radius:22rpx;box-shadow:0 18rpx 42rpx rgba(104,73,42,0.13);overflow:hidden}
.login-guide::before{content:"";position:absolute;left:26rpx;right:26rpx;top:0;height:7rpx;border-radius:0 0 999rpx 999rpx;background:linear-gradient(90deg,var(--primary) 0%,#eab071 48%,#6f8d67 100%)}
.login-guide::after{content:"";position:absolute;right:-54rpx;top:24rpx;width:178rpx;height:178rpx;border-radius:50%;background:radial-gradient(circle,#fff7e6 0%,rgba(234,176,113,0.42) 54%,rgba(234,176,113,0) 70%);opacity:.9}
.guide-badge{position:relative;width:112rpx;height:112rpx;margin-bottom:24rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:radial-gradient(circle at 42% 38%,#ffe6aa 0%,#d8512f 54%,#91372c 100%);box-shadow:0 16rpx 32rpx rgba(216,81,47,0.26);z-index:1}
.guide-badge::before{content:"";position:absolute;inset:10rpx;border-radius:50%;border:2rpx solid rgba(255,250,240,0.74)}
.guide-mark{position:relative;color:#fff9eb;font-size:38rpx;font-weight:900;text-shadow:0 5rpx 12rpx rgba(79,42,24,0.24);z-index:2}
.guide-spark{position:absolute;display:block;border-radius:50%;background:#ffe2a1;box-shadow:0 3rpx 10rpx rgba(79,42,24,0.16);z-index:3}
.spark-one{right:20rpx;top:21rpx;width:13rpx;height:13rpx}
.spark-two{left:24rpx;bottom:20rpx;width:9rpx;height:9rpx;background:#fff5dc}
.guide-copy{position:relative;z-index:1}
.guide-kicker{margin-bottom:10rpx;color:#a86b38;font-size:18rpx;font-weight:900;letter-spacing:0}
.guide-title{color:var(--text-dark);font-size:39rpx;font-weight:900;line-height:1.18}
.guide-desc{margin-top:14rpx;max-width:570rpx;color:#76583f;font-size:26rpx;line-height:1.55}
.guide-tags{position:relative;display:flex;gap:12rpx;margin-top:22rpx;z-index:1}
.guide-tag{padding:9rpx 18rpx;border-radius:999rpx;background:rgba(255,255,255,0.62);border:1rpx solid rgba(216,81,47,0.12);color:#93623b;font-size:22rpx;font-weight:800}
.guide-btn{position:relative;margin:28rpx 0 0;width:100%;height:82rpx;line-height:82rpx;padding:0;border:none;border-radius:999rpx;background:linear-gradient(135deg,#d85a37 0%,var(--primary) 64%,#a63d32 100%);color:#fff9eb;font-size:28rpx;font-weight:900;box-shadow:0 16rpx 30rpx rgba(216,81,47,0.28);z-index:1}
.guide-btn::after{border:none}
.form-section{margin:22rpx 24rpx;padding:24rpx;background:var(--card-bg);border:1rpx solid var(--border);border-radius:var(--radius-lg);box-shadow:0 10rpx 26rpx var(--shadow-sm)}
.map-section{padding:0;overflow:hidden}
.section-title{font-size:27rpx;font-weight:800;color:#3a2c22;margin-bottom:18rpx;padding:0}
.map-section .section-title{padding:24rpx 24rpx 0}
.location-search{display:flex;padding:0 24rpx 20rpx;align-items:center}
.location-btn{width:138rpx;height:76rpx;line-height:76rpx;padding:0;background:var(--text-dark);color:#fff;border-radius:var(--radius-sm);font-size:27rpx;font-weight:800}
.location-btn.wide{width:100%}
.picker-map{width:100%;height:410rpx;margin-top:8rpx}
.address-text{font-size:25rpx;color:#76583f;padding:18rpx 24rpx;background:var(--accent-light);border-top:1rpx solid var(--border-light);line-height:1.4}
.form-input{height:88rpx;min-height:88rpx;line-height:88rpx;padding:0 22rpx;background:#fff;border-radius:var(--radius-sm);border:1rpx solid #e5d0b7;font-size:29rpx;width:100%;color:var(--text)}
.optional-input{margin-bottom:16rpx}.optional-input.last{margin-bottom:0}
.custom-tag-row{display:flex;gap:12rpx;margin-bottom:18rpx}
.custom-tag-input{flex:1;height:76rpx;line-height:76rpx;padding:0 20rpx;background:#fff;border:1rpx solid #e5d0b7;border-radius:var(--radius-sm);font-size:26rpx;color:var(--text)}
.custom-tag-btn{width:126rpx;height:76rpx;line-height:76rpx;padding:0;background:var(--text-dark);color:#fff;border-radius:var(--radius-sm);font-size:26rpx;font-weight:800}
.tag-list{display:flex;flex-wrap:wrap;gap:12rpx}.tag{padding:11rpx 22rpx;border:1rpx solid var(--border-warm);border-radius:var(--radius-lg);font-size:24rpx;color:#6d513a;background:#fff}
.tag.active{border-color:var(--primary);color:#fff;background:var(--primary);font-weight:800;box-shadow:0 8rpx 18rpx var(--primary-shadow)}
.moments-section{padding-bottom:28rpx}
.form-textarea{padding:22rpx 22rpx 12rpx;background:#fff;border-radius:var(--radius-sm) var(--radius-sm) 0 0;border:1rpx solid #e5d0b7;border-bottom:none;font-size:28rpx;height:220rpx;width:100%;color:var(--text);line-height:1.5}
.char-count{text-align:right;font-size:22rpx;color:#a78a6d;padding:10rpx 18rpx 14rpx;background:#fff;border-left:1rpx solid #e5d0b7;border-right:1rpx solid #e5d0b7}
.photo-grid{display:flex;flex-wrap:wrap;gap:14rpx;padding:18rpx;background:#fff;border:1rpx solid #e5d0b7;border-top:1rpx solid var(--accent-light);border-radius:0 0 var(--radius-sm) var(--radius-sm)}.photo-item{position:relative;width:190rpx;height:190rpx}.photo-img{width:100%;height:100%;border-radius:8rpx}
.photo-del{position:absolute;top:8rpx;right:8rpx;width:38rpx;height:38rpx;background:rgba(37,31,26,0.68);color:#fff;border-radius:50%;text-align:center;line-height:36rpx;font-size:26rpx}
.photo-add{width:196rpx;height:196rpx;border:2rpx dashed #cfa77b;border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;font-size:52rpx;color:var(--accent);background:var(--accent-bg)}
.submit-btn{margin:36rpx 24rpx 0;background:var(--primary);color:#fff;border-radius:var(--radius-lg);font-size:31rpx;font-weight:800;padding:24rpx;box-shadow:0 16rpx 30rpx rgba(216,81,47,0.24)}
