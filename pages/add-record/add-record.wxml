<view class="page">
  <view class="form-hero">
    <text class="eyebrow">{{isEdit?'EDIT TASTE':'NEW TASTE'}}</text>
    <view class="hero-title">{{isEdit?'编辑记录':'添加记录'}}</view>
  </view>
  <view class="form-section map-section">
    <view class="section-title">选择位置</view>
    <view class="location-search">
      <button class="location-btn wide" bindtap="handleSearchLocation">打开地图搜索位置</button>
    </view>
    <map class="picker-map" latitude="{{pickLat}}" longitude="{{pickLng}}" scale="{{pickScale}}" markers="{{pickMarkers}}" bindtap="handleMapTap" show-location="{{false}}"></map>
    <view class="address-text">{{address || '点击地图选择位置'}}</view>
  </view>
  <view class="form-section">
    <view class="section-title">店铺名称</view>
    <input class="form-input" placeholder="输入店铺名称" value="{{name}}" bindinput="onNameInput" confirm-type="done" />
  </view>
  <view class="form-section">
    <view class="section-title">评分</view>
    <star-rating rating="{{rating}}" size="a" bind:change="onRatingChange" />
  </view>
  <view class="form-section moments-section">
    <view class="section-title">图文评价</view>
    <textarea class="form-textarea" placeholder="写下你的美食感受..." value="{{comment}}" bindinput="onCommentInput" maxlength="500" />
    <view class="char-count">{{comment.length}}/500</view>
    <view class="photo-grid">
      <view wx:for="{{photos}}" wx:for-index="i" wx:key="*this" class="photo-item">
        <image class="photo-img" src="{{item}}" mode="aspectFill" lazy-load />
        <text class="photo-del" bindtap="handleRemovePhoto" data-index="{{i}}">×</text>
      </view>
      <view wx:if="{{photos.length<9}}" class="photo-add" bindtap="handleAddPhoto">+</view>
    </view>
  </view>
  <view class="form-section">
    <view class="section-title">标签</view>
    <view class="custom-tag-row">
      <input class="custom-tag-input" placeholder="自定义标签，如 宝藏店" value="{{customTag}}" bindinput="onCustomTagInput" confirm-type="done" bindconfirm="addCustomTag" />
      <button class="custom-tag-btn" bindtap="handleAddCustomTag">添加</button>
    </view>
    <view class="tag-list">
      <text wx:for="{{displayTags}}" wx:key="key" class="tag {{item.active?'active':''}}" bindtap="handleToggleTag" data-key="{{item.key}}">{{item.name}}</text>
    </view>
  </view>
  <button class="submit-btn" bindtap="handleSubmit" loading="{{submitting}}">{{isEdit?'保存修改':'保存记录'}}</button>
</view>


