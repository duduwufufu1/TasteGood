<view class="page">
  <view class="login-card">
    <view class="login-user">
      <image wx:if="{{isLoggedIn && user.avatarUrl}}" class="login-avatar" src="{{user.avatarUrl}}" mode="aspectFill" lazy-load />
      <view wx:else class="login-avatar avatar-fallback">味</view>
      <view class="login-copy">
        <view class="login-name">{{isLoggedIn ? user.nickName : '未登录'}}</view>
        <view class="login-desc">{{isLoggedIn ? '只展示你的美食记录' : '登录后按微信用户分离记录'}}</view>
      </view>
    </view>
    <button wx:if="{{!isLoggedIn}}" class="login-btn" loading="{{loginLoading}}" bindtap="handleLogin">微信登录</button>
    <view wx:else class="profile-actions">
      <text class="edit-profile-btn" bindtap="handleEditProfile">修改资料</text>
      <text class="logout-btn" bindtap="handleLogout">退出</text>
    </view>
  </view>

  <login-panel
    visible="{{showLoginPanel}}"
    title="{{profilePanelTitle}}"
    desc="{{profilePanelDesc}}"
    submitText="{{profilePanelSubmitText}}"
    avatarUrl="{{pendingAvatarUrl}}"
    nickName="{{pendingNickName}}"
    loading="{{loginLoading}}"
    bind:close="closeLoginPanel"
    bind:chooseavatar="onChooseAvatar"
    bind:nicknameinput="onNickNameInput"
    bind:confirm="confirmLogin"
  />

  <view class="section atlas-section">
    <view class="section-head">
      <view>
        <text class="section-kicker">HEAT MAP</text>
        <view class="section-title">美食足迹</view>
      </view>
      <view class="atlas-summary">{{mappedRecordCount}} 家店铺</view>
    </view>

    <view class="atlas-board">
      <view class="china-atlas">
        <canvas
          wx:if="{{useVectorMap && !showLoginPanel}}"
          type="2d"
          id="tasteAtlasCanvas"
          class="atlas-canvas"
          bindtouchstart="onAtlasTouchStart"
          catchtouchmove="onAtlasTouchMove"
          bindtouchend="onAtlasTouchEnd"
          bindtouchcancel="onAtlasTouchEnd"
        ></canvas>
        <view wx:if="{{useVectorMap && !showLoginPanel}}" class="atlas-tools">
          <view class="atlas-tool" bindtap="handleResetAtlasViewport">↺</view>
        </view>

        <block wx:if="{{!useVectorMap}}">
          <view
            wx:for="{{mapCities}}"
            wx:key="city"
            class="city-block {{item.statusClass}} {{item.heatClass}}"
            style="left:{{item.left}}rpx;top:{{item.top}}rpx;width:{{item.width}}rpx;height:{{item.height}}rpx;border-radius:{{item.radius}};transform:rotate({{item.rotate}}deg) skewX({{item.skew}}deg);"
            bindtap="handleShowCityTaste"
            data-city="{{item.city}}"
            data-count="{{item.count}}"
          >
            <text class="city-name">{{item.shortName}}</text>
          </view>
        </block>

        <view class="atlas-empty" wx:if="{{!hasMapRecords}}">还没有点亮城市</view>
      </view>

      <view class="atlas-legend">
        <view class="heat-legend">
          <text>低</text>
          <view class="heat-bar"></view>
          <text>高</text>
        </view>
        <view class="legend-item"><text class="legend-swatch muted"></text><text>未记录</text></view>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{wordCloud.length}}">
    <view class="section-head">
      <view>
        <text class="section-kicker">WORDS</text>
        <view class="section-title">评价词云</view>
      </view>
    </view>
    <view class="word-cloud">
      <text wx:for="{{wordCloud}}" wx:key="text" class="word" style="left:{{item.left}}rpx;top:{{item.top}}rpx;font-size:{{item.size}}rpx;color:{{item.color}};transform:rotate({{item.rotate}}deg)">{{item.text}}</text>
    </view>
  </view>

  <view class="section" wx:if="{{photoWall.length}}">
    <view class="section-head">
      <view>
        <text class="section-kicker">PHOTOS</text>
        <view class="section-title">照片墙</view>
      </view>
    </view>
    <view class="photo-wall">
      <image wx:for="{{photoWall}}" wx:key="src" class="wall-img" src="{{item.src}}" mode="aspectFill" lazy-load bindtap="handlePreviewPhoto" data-src="{{item.src}}" />
    </view>
  </view>

  <view class="section recent-section">
    <view class="section-head">
      <view>
        <text class="section-kicker">RECENT</text>
        <view class="section-title">最近记录</view>
      </view>
    </view>
    <view wx:for="{{recentRecords}}" wx:key="_id" class="recent-item" bindtap="handleGoDetail" data-id="{{item._id}}">
      <image wx:if="{{item.images && item.images[0]}}" class="recent-img" src="{{item.images[0]}}" mode="aspectFill" lazy-load />
      <view wx:else class="recent-img recent-fallback">味</view>
      <view class="recent-info">
        <view class="recent-name">{{item.name}}</view>
        <view class="recent-meta">{{item.city}} · {{item.rating}}星</view>
      </view>
    </view>
    <view wx:if="{{!recentRecords.length}}" class="recent-empty">还没有美食记录</view>
  </view>
</view>



