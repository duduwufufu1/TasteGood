<view class="page city-page">
  <view class="city-hero">
    <text class="eyebrow">FOOD ATLAS</text>
    <view class="hero-title hero-centered">我的味觉版图</view>
    <text class="hero-subtitle">每座城市，收好一枚味觉印章</text>
    <view class="hero-stats">
      <view class="stat-item">
        <text class="stat-num">{{cities.length}}</text>
        <text class="stat-label">城市</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{totalRecords}}</text>
        <text class="stat-label">店铺</text>
      </view>
    </view>
  </view>
  <view class="section-hd">
    <text class="section-title">探索城市</text>
    <text class="section-sub">点击城市查看详情</text>
  </view>
  <view class="city-grid">
    <view wx:for="{{cities}}" wx:key="city" class="city-card" bindtap="handleGoToCity" data-city="{{item.city}}" data-lat="{{item.lat}}" data-lng="{{item.lng}}">
      <text class="city-initial">{{item.abbr || item.city.slice(0,2)}}</text>
      <view class="city-photos" wx:if="{{item.photos.length > 0}}">
        <image wx:for="{{item.photos}}" wx:key="*this" wx:for-item="photo" src="{{photo}}" mode="aspectFill" lazy-load class="city-photo" />
      </view>
      <view class="city-name">{{item.city}}</view>
      <view class="city-count">{{item.count}} 家店铺</view>
    </view>
  </view>
  <view class="fab-add" bindtap="handleGoAddRecord">+</view>
  <view wx:if="{{cities.length===0}}" class="empty-state">
    <text class="empty-title">还没有城市印章</text>
    <text class="empty-copy">去记录你品尝过的第一家店吧</text>
    <button class="start-btn" bindtap="handleGoAddRecord">开始记录</button>
  </view>
</view>
