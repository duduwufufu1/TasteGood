.city-page{min-height:100vh;background:#f7f1e7;padding-bottom:34rpx}
.city-hero{margin:0 24rpx 22rpx;padding:42rpx 32rpx 34rpx;background:#2f281f;color:#fff;border-radius:0 0 18rpx 18rpx;box-shadow:0 20rpx 42rpx rgba(48,39,31,0.2)}
.eyebrow{display:block;font-size:20rpx;color:#eab071;font-weight:700;letter-spacing:0;margin-bottom:14rpx}
.hero-title{font-size:48rpx;font-weight:900;line-height:1.1}
.hero-copy{display:block;margin-top:12rpx;font-size:25rpx;color:#ead9c3}
.city-grid{padding:0 24rpx;display:grid;grid-template-columns:1fr 1fr;gap:18rpx}
.city-card{min-height:230rpx;background:#fffaf2;border-radius:12rpx;padding:24rpx;border:1rpx solid rgba(75,54,34,0.1);box-shadow:0 12rpx 30rpx rgba(76,54,32,0.08);position:relative;overflow:hidden}
.stamp-ring{width:92rpx;height:92rpx;border:3rpx solid #d8512f;border-radius:50%;display:flex;align-items:center;justify-content:center;margin-bottom:18rpx;background:#fff4e5}
.city-initial{font-size:28rpx;font-weight:900;color:#8f321d;max-width:74rpx;text-align:center;line-height:1.1}
.city-name{font-size:34rpx;font-weight:900;margin-bottom:8rpx;color:#251f1a}
.city-count{font-size:24rpx;color:#8b6a4d}
.empty-state{display:flex;flex-direction:column;align-items:center;margin:60rpx 24rpx 0;padding:80rpx 40rpx;color:#8b6a4d;font-size:28rpx;background:#fffaf2;border:1rpx dashed #d8b58d;border-radius:14rpx}
.empty-title{font-size:32rpx;font-weight:800;color:#2f281f;margin-bottom:8rpx}.empty-copy{font-size:25rpx;color:#9b7553}
.start-btn{margin-top:32rpx;background:#d8512f;color:#fff;border-radius:16rpx;padding:18rpx 48rpx;font-size:28rpx;box-shadow:0 12rpx 24rpx rgba(216,81,47,0.22)}
