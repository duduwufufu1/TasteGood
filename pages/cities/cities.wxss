.city-page{min-height:100vh;background:var(--bg);padding-bottom:34rpx}
.city-hero{margin:0 24rpx 22rpx;padding:42rpx 32rpx 34rpx;background:var(--text-dark);color:#fff;border-radius:0 0 18rpx 18rpx;box-shadow:0 20rpx 42rpx rgba(48,39,31,0.2)}
.eyebrow{display:block;font-size:20rpx;color:#eab071;font-weight:700;letter-spacing:0;margin-bottom:14rpx}
.hero-title{font-size:48rpx;font-weight:900;line-height:1.1}
.hero-copy{display:block;margin-top:12rpx;font-size:25rpx;color:#ead9c3}
.city-grid{padding:0 24rpx;display:grid;grid-template-columns:1fr 1fr;gap:18rpx}
.city-card{min-height:230rpx;background:var(--card-bg);border-radius:var(--radius);padding:24rpx;border:1rpx solid var(--border);box-shadow:0 12rpx 30rpx var(--shadow-md);position:relative;overflow:hidden}
.stamp-ring{width:92rpx;height:92rpx;border:3rpx solid var(--primary);border-radius:50%;display:flex;align-items:center;justify-content:center;margin-bottom:18rpx;background:var(--accent-bg)}
.city-initial{font-size:28rpx;font-weight:900;color:#8f321d;max-width:74rpx;text-align:center;line-height:1.1}
.city-name{font-size:34rpx;font-weight:900;margin-bottom:8rpx;color:var(--text)}
.city-count{font-size:24rpx;color:var(--text-secondary)}
.empty-state{display:flex;flex-direction:column;align-items:center;margin:60rpx 24rpx 0;padding:80rpx 40rpx;color:var(--text-secondary);font-size:28rpx;background:var(--card-bg);border:1rpx dashed var(--border-warm);border-radius:var(--radius-lg)}
.empty-title{font-size:32rpx;font-weight:800;color:var(--text-dark);margin-bottom:8rpx}.empty-copy{font-size:25rpx;color:var(--text-muted)}
.start-btn{margin-top:32rpx;background:var(--primary);color:#fff;border-radius:16rpx;padding:18rpx 48rpx;font-size:28rpx;box-shadow:0 12rpx 24rpx var(--primary-shadow)}
