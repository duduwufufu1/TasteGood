<view class="page">
  <view class="list-hero">
    <text class="eyebrow">TASTING LOG</text>
    <view class="hero-title">美食记录</view>
  </view>
  <view class="filter-bar">
    <picker mode="selector" range="{{cityList}}" bindchange="onCityChange">
      <text class="filter-btn">{{currentCity || '全部城市'}} ▼</text>
    </picker>
    <picker mode="selector" range="{{tagList}}" bindchange="onTagChange">
      <text class="filter-btn">{{currentTagName || '全部标签'}} ▼</text>
    </picker>
    <picker mode="selector" range="{{ratingList}}" bindchange="onRatingChange">
      <text class="filter-btn">{{currentRating ? '≥' + currentRating + '星' : '全部星级'}} ▼</text>
    </picker>
    <text class="filter-btn sort" bindtap="handleToggleSort">{{sortAsc?'最早':'最近'}}</text>
  </view>
  <scroll-view scroll-y class="record-list" bindscrolltolower="handleLoadMore">
    <record-card
      wx:for="{{records}}" wx:key="_id"
      record-id="{{item._id}}"
      name="{{item.name}}"
      rating="{{item.rating}}"
      city="{{item.city}}"
      address="{{item.address}}"
      photo="{{item.images[0]}}"
      dish-name="{{item.dishName}}"
      price="{{item.price}}"
      review-title="{{item.reviewTitle}}"
      visit-text="{{item.visitText}}"
      visit-count="{{item.visitCount}}"
      bind:tap="handleGoDetail"
    />
    <view wx:if="{{!loading && !records.length}}" class="empty-list">
      <text class="empty-title">还没有味觉足迹</text>
      <text class="empty-copy">去地图上添加第一家店</text>
    </view>
    <view wx:if="{{loading}}" class="loading">加载中…</view>
  </scroll-view>
</view>
