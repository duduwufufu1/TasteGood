<view class="page">
  <view class="list-hero">
    <text class="eyebrow">TASTING LOG</text>
    <view class="hero-title">美食记录</view>
  </view>
  <view class="filter-bar">
    <picker mode="selector" range="{{cityList}}" bindchange="onCityChange">
      <text class="filter-btn">{{currentCity || '全部城市'}} ▼</text>
    </picker>
    <picker mode="selector" range="{{tagList}}" bindchange="onTagChange">
      <text class="filter-btn">{{currentTagName || '全部标签'}} ▼</text>
    </picker>
    <text class="filter-btn sort" bindtap="toggleSort">{{sortAsc?'最早':'最近'}}</text>
  </view>
  <scroll-view scroll-y class="record-list" bindscrolltolower="loadMore">
    <view wx:for="{{records}}" wx:key="_id" class="record-item" bindtap="goDetail" data-id="{{item._id}}">
      <image wx:if="{{item.images && item.images[0]}}" class="item-img" src="{{item.images[0]}}" mode="aspectFill" />
      <view wx:else class="item-img no-img">味</view>
      <view class="item-info">
        <view class="item-name">{{item.name}}</view>
        <view class="item-rating">
          <text wx:for="{{[1,2,3,4,5]}}" wx:for-item="star" wx:key="*this" class="star-l {{item.rating>=star?'active':''}}">★</text>
        </view>
        <view class="item-address">{{item.city}} · {{item.address}}</view>
      </view>
    </view>
    <view wx:if="{{!loading && !records.length}}" class="empty-list">
      <text class="empty-title">还没有记录</text>
      <text class="empty-copy">去地图上添加第一家店</text>
    </view>
    <view wx:if="{{loading}}" class="loading">加载中…</view>
  </scroll-view>
</view>
