.page{min-height:100vh;background:#f7f1e7;padding-bottom:24rpx}
.list-hero{padding:38rpx 28rpx 24rpx;background:#fffaf2;border-bottom:1rpx solid #ead9c3}
.eyebrow{display:block;font-size:20rpx;color:#a84e2b;font-weight:800;letter-spacing:0;margin-bottom:8rpx}
.hero-title{font-size:46rpx;font-weight:900;color:#251f1a}
.filter-bar{display:flex;padding:18rpx 24rpx;background:#f7f1e7;gap:14rpx;border-bottom:1rpx solid #ead9c3}
.filter-btn{display:block;font-size:25rpx;color:#5c4532;padding:12rpx 18rpx;border:1rpx solid #d9c0a3;border-radius:14rpx;background:#fffaf2;max-width:220rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.filter-btn.sort{color:#fff;border-color:#d8512f;background:#d8512f}
.record-list{height:calc(100vh - 190rpx);padding:10rpx 24rpx 0}
.record-item{display:flex;padding:18rpx;margin-bottom:16rpx;background:#fffaf2;border:1rpx solid rgba(75,54,34,0.1);border-radius:12rpx;box-shadow:0 10rpx 26rpx rgba(76,54,32,0.07)}
.item-img{width:164rpx;height:164rpx;border-radius:8rpx;margin-right:20rpx;flex-shrink:0;background:#ead9c3}
.no-img{display:flex;align-items:center;justify-content:center;color:#8f321d;font-size:48rpx;font-weight:900;background:linear-gradient(135deg,#f2d7b8,#fff4e5)}
.item-info{flex:1;display:flex;flex-direction:column;justify-content:center;min-width:0}
.item-name{font-size:32rpx;font-weight:800;margin-bottom:8rpx;color:#251f1a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.item-rating{margin-bottom:8rpx}.star-l{font-size:24rpx;color:#d4c0aa}.star-l.active{color:#d8512f}
.item-address{font-size:24rpx;color:#8b6a4d;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.empty-list{display:flex;flex-direction:column;align-items:center;margin-top:90rpx;padding:70rpx 30rpx;color:#8b6a4d;font-size:28rpx;background:#fffaf2;border:1rpx dashed #d8b58d;border-radius:14rpx}
.empty-title{font-size:32rpx;color:#251f1a;font-weight:800;margin-bottom:8rpx}.empty-copy{font-size:25rpx;color:#9b7553}
.loading{text-align:center;padding:30rpx;color:#9b7553}
