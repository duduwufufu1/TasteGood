.page{min-height:100vh;background:#eaf0ec;padding-bottom:24rpx}
.list-hero{padding:38rpx 28rpx 24rpx;background:#fffaf0;border-bottom:1rpx solid rgba(18,35,31,0.08)}
.eyebrow{display:block;font-size:20rpx;color:#6f8d67;font-weight:800;letter-spacing:1px;margin-bottom:8rpx}
.hero-title{font-size:46rpx;font-weight:900;color:#12231f}
.filter-bar{display:flex;padding:18rpx 24rpx;background:#eaf0ec;gap:14rpx;border-bottom:1rpx solid rgba(18,35,31,0.08)}
.filter-btn{display:block;font-size:25rpx;color:#314b45;padding:12rpx 18rpx;border:1rpx solid #61726e44;border-radius:10rpx;background:#fffaf0;max-width:220rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.filter-btn.sort{color:#fff;border-color:#c84632;background:#c84632}
.record-list{height:calc(100vh - 190rpx);padding:10rpx 24rpx 0}
.empty-list{display:flex;flex-direction:column;align-items:center;margin-top:90rpx;padding:70rpx 30rpx;color:#61726e;font-size:28rpx;background:#fffaf0;border:1rpx dashed #102b2822;border-radius:14rpx}
.empty-title{font-size:32rpx;color:#12231f;font-weight:800;margin-bottom:8rpx}.empty-copy{font-size:25rpx;color:#61726e}
.loading{text-align:center;padding:30rpx;color:#61726e}